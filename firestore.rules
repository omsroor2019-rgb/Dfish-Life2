rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.enabled == true;
    }

    // Public users can only read published matches. Only an enabled admin can write.
    match /matches/{matchId} {
      allow get, list: if isAdmin() || resource.data.enabled == true;
      allow create, update, delete: if isAdmin();
    }

    // An admin can read only their own role document. Clients cannot create or edit roles.
    match /admin_users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Deny every other document path by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
